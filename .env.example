# Deploy Doctor Environment Configuration

# Server Ports
PORT=4000
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deploydoctor
DATABASE_SSL=false

# CORS Configuration (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GitHub API Token (Optional: Increases rate limits from 60 to 5000 requests/hour)
GITHUB_TOKEN=ghp_your_github_token_here

# Google Gemini API Key (Optional: Powers AI risk diagnostics via your 1-Year Gemini Subscription)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# LLM / OpenAI API Key (Optional alternative)
LLM_API_KEY=sk-your_openai_or_llm_api_key_here

# Zerops Cloud REST API Token (Required for Real One-Click Deploy)
ZEROPS_API_TOKEN=your_zerops_access_token_here

